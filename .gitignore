__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Generated corpora and models are large and reproducible; the release dataset
# is exported explicitly in Phase 7 and lives outside the repo until cleaned.
data/logs/*.jsonl
data/labels/*.jsonl
data/models/*.joblib
data/decoy/*.sqlite3
data/*.sqlite3
*.sqlite3

# Derived thresholds are regenerated from the FROZEN cost table; never edit by hand.
config/thresholds.generated.yaml

figures/
*.log
.env

# L2 pentest-tool venv (sqlmap/ghauri/wapiti) — isolated from global Python
.venv-l2/
data/l2/
.venv-wapiti/
# Evaluation logs, at whatever depth. `data/eval/*/logs/` only matched one
# level, so a sharded or per-draw run writing to data/eval/<study>/<draw>/logs/
# slipped past it -- which is how gigabytes of request logs ended up tracked and
# broke `git push`. The recovery for that was a history rewrite, which also
# deleted the logs from the working tree; the pattern below is what prevents a
# repeat.
data/eval/**/logs/
data/eval/**/*.sqlite3