    <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a1a;fontFamily=Georgia;" value="How a labelled corpus is built — and why the join is verified" vertex="1">
      <mxGeometry height="30" width="760" x="40" y="16" as="geometry" />
    </mxCell>
    <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5a5a5a;fontFamily=Georgia;" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;Labels are written before the traffic happens, into a separate file, so the detection path cannot accidentally read the answer key.&lt;/font&gt;" vertex="1">
      <mxGeometry height="22" width="1000" x="40" y="48" as="geometry" />
    </mxCell>
    <mxCell id="seclabel" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#8a8a8a;fontFamily=Georgia;letterSpacing=1;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;GENERATORS · LABEL AT THE POINT OF GENERATION&lt;/font&gt;" vertex="1">
      <mxGeometry height="18" width="500" x="40" y="78" as="geometry" />
    </mxCell>
    <mxCell id="g1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#c8c8c8;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;benign_traffic.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;simulated humans, plus the&lt;br&gt;awkward-but-honest personas&lt;/font&gt;&lt;/font&gt;" vertex="1">
