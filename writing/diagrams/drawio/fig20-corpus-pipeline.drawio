      <mxGeometry height="70" width="250" x="40" y="268" as="geometry" />
    </mxCell>
    <mxCell id="app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#c8c8c8;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;target application&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;the deliberately weak site —&lt;br&gt;knows nothing of adf/&lt;/font&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="70" width="250" x="359" y="140" as="geometry" />
    </mxCell>
    <mxCell id="logs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#c8c8c8;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;data/logs/*.jsonl&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;append-only, hash-chained,&lt;br&gt;tamper-evident (NFR-13)&lt;/font&gt;" vertex="1">
      <mxGeometry height="70" width="250" x="740" y="140" as="geometry" />
    </mxCell>
    <mxCell id="labels" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fdf1dc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;data/labels/*.jsonl&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7a5a1a&quot;&gt;ground truth, written BEFORE the session&lt;br&gt;acts (§7.3) — never inside the traffic log&lt;/font&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="70" width="250" x="359" y="268" as="geometry" />
    </mxCell>
    <mxCell id="dataset" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fafafa;strokeColor=#c8c8c8;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=12;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;adf.dataset&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6b6b6b&quot;&gt;joins the two on session.provenance_id,&lt;br&gt;carried in the X-ADF-Session header&lt;/font&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="70" width="246" x="742" y="268" as="geometry" />
    </mxCell>
    <mxCell id="verified" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#eef7f1;strokeColor=#1f7a52;fontSize=11;fontFamily=Georgia;align=left;spacingLeft=16;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#155f40&quot;&gt;verified corpus&amp;nbsp; →&amp;nbsp; &lt;/font&gt;&lt;font face=&quot;Courier New&quot; color=&quot;#155f40&quot;&gt;tools/corpus_report.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3f5a4e&quot;&gt;Join coverage is a reported result, not an assumption: the build refuses to emit a corpus below 95%.&lt;br&gt;The report then runs the phase exit gates — 6 checks for Phase 1, 7 for Phase 2 — and prints PASS or FAIL for each.&lt;/font&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="80" width="950" x="40" y="395" as="geometry" />
    </mxCell>
    <mxCell id="note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#6b6b6b;fontFamily=Georgia;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;Why the join is checked rather than trusted: the first version of it silently produced zero matches. Labels were keyed by the generator&#39;s session id,&lt;br&gt;records by the application&#39;s cookie — two namespaces that never met. Nothing raised, every downstream statistic still computed, and every one&lt;br&gt;of them was meaningless.&lt;br&gt;&lt;br&gt;One command does the whole lifecycle — wipe, seed, start a private server, generate, stop, assemble, verify:&amp;nbsp; &lt;font face=&quot;Courier New&quot; style=&quot;&quot;&gt;python -m tools.generate_corpus&lt;/font&gt;&lt;/font&gt;" vertex="1">
      <mxGeometry height="90" width="950" x="40" y="500" as="geometry" />
    </mxCell>
