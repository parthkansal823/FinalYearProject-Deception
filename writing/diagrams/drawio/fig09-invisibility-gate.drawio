        <mxCell id="title" value="The invisibility gate — three tests, verified before use" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=19;fontColor=#1a1a1a;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="880" height="30" as="geometry" /></mxCell>

        <mxCell id="cand" value="&lt;b&gt;candidate bait&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#e6e6e6;strokeColor=#8a8a8a;fontSize=13;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="410" y="100" width="180" height="46" as="geometry" /></mxCell>

        <mxCell id="t1" value="1. rendered output&lt;br&gt;unchanged&lt;br&gt;(post-JS DOM + text)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ddebf7;strokeColor=#4a86c8;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="90" y="205" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="t2" value="2. no functional&lt;br&gt;change&lt;br&gt;(forms, links, parse)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ddebf7;strokeColor=#4a86c8;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="385" y="205" width="230" height="80" as="geometry" /></mxCell>
        <mxCell id="t3" value="3. no timing change&lt;br&gt;(median overhead&lt;br&gt;under 0.5 ms)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ddebf7;strokeColor=#4a86c8;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="680" y="205" width="230" height="80" as="geometry" /></mxCell>

        <mxCell id="gate" value="all three&lt;br&gt;pass?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf1dc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="400" y="350" width="200" height="110" as="geometry" /></mxCell>

        <mxCell id="del" value="&lt;b&gt;deleted&lt;br&gt;(not repaired)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fbe4e2;strokeColor=#c0392b;fontSize=12;fontFamily=Georgia;fontColor=#8c2a20;" vertex="1" parent="1"><mxGeometry x="90" y="370" width="200" height="70" as="geometry" /></mxCell>

